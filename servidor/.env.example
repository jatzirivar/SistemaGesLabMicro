# Copia este archivo como ".env" y llena tus datos.
# El archivo .env NUNCA se sube a Git (tiene contraseñas).

# --- Base de datos PostgreSQL ---
DB_USUARIO=postgres
DB_CONTRASENA=escribe_aqui_tu_contraseña_de_postgres
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE=gestion_prestamos

# --- Sesiones (JWT) ---
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRETO=pega_aqui_el_texto_generado
JWT_MINUTOS=480

# --- Direcciones desde donde el frontend (React) puede llamar a la API ---
CORS_ORIGENES=["http://localhost:5173"]
